{
  "$jsonSchema": {
    "bsonType": "object",
    "required": [
      "key",
      "variableName",
      "appName",
      "updatedAt",
      "sourceSystem",
      "subTenancy",
      "sourceSystemService",
      "updatedBy",
      "version"
    ],
    "additionalProperties": false,
    "properties": {
      "_id": {
        "bsonType": "objectId"
      },
      "key": {
        "bsonType": "string"
      },
