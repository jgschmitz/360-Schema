              "tierNumber": { "bsonType": "string" },
              "benefitCategory": { "bsonType": "string" },
              "benefitCategoryDisplayName": { "bsonType": "string" },
              "paymentLineValue": { "bsonType": "string" },
              "paymentLineDescription": { "bsonType": "string" },
