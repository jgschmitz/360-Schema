              "limitTier": { "bsonType": "string" },
              "limitType": { "bsonType": "string" },
              "limitType1": { "bsonType": "string" },
              "appliesTo": { "bsonType": "string" },
              "freqencyType": { "bsonType": "string" },
              "isCovered": { "bsonType": "string" },
              "multiplyBy": { "bsonType": "string" },
              "id": {
                "bsonType": "string",
                "description": "Cirrus/Nimbus mapping sheets only: source-system row id"
              },
              "fieldName": {
                "bsonType": "string",
                "description": "Cirrus 'sheet1' only: display label for the mapped field"
              },
              "returnValue": {
                "bsonType": "string",
                "description": "Cirrus 'sheet1' / Nimbus 'Sheet 1' only: literal/return value for this mapping row"
              }
            }
          }
        }
      }
    }
  }
}
